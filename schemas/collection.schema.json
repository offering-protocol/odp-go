{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offeringprotocol.org/schemas/collection.schema.json",
  "title": "ODP Full Collection Representation",
  "type": "object",
  "required": [
    "odp_version",
    "id",
    "name"
  ],
  "properties": {
    "auth_expands": {
      "const": true
    },
    "odp_version": {
      "const": "1.0"
    },
    "id": {
      "$ref": "local-resource-identifier.schema.json"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "resource-image.schema.json"
      }
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35
    },
    "localizations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 35
      }
    },
    "parent_ids": {
      "allOf": [
        {
          "$ref": "local-resource-identifier-list.schema.json"
        },
        {
          "minItems": 1
        }
      ]
    },
    "web_url": {
      "$ref": "resource-reference.schema.json"
    },
    "search_capabilities": {
      "$ref": "search-capabilities.schema.json"
    }
  }
}
