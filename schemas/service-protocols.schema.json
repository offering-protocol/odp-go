{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offeringprotocol.org/schemas/service-protocols.schema.json",
  "title": "ODP Service protocol support",
  "type": "object",
  "minProperties": 1,
  "properties": {
    "enrollment": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "enrollment-protocol.schema.json"
      }
    },
    "payments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "payment-protocol.schema.json"
      }
    },
    "trust": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "trust-protocol.schema.json"
      }
    }
  },
  "allOf": [
    {
      "properties": {
        "payments": {
          "contains": {
            "properties": {
              "name": {
                "const": "mpp"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "payments": {
          "contains": {
            "properties": {
              "name": {
                "const": "x402"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        }
      }
    },
    {
      "if": {
        "properties": {
          "payments": {
            "contains": {
              "properties": {
                "authentication": {
                  "const": "required"
                }
              },
              "required": [
                "authentication"
              ]
            }
          }
        },
        "required": [
          "payments"
        ]
      },
      "then": {
        "required": [
          "enrollment"
        ]
      }
    }
  ],
  "additionalProperties": false
}
