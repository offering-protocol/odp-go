{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offeringprotocol.org/schemas/service-document.schema.json",
  "title": "ODP Service Document",
  "type": "object",
  "required": [
    "odp_version",
    "name",
    "description",
    "language",
    "localizations",
    "operations",
    "http"
  ],
  "properties": {
    "odp_version": {
      "const": "1.0"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "documentation_url": {
      "$ref": "resource-reference.schema.json"
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35
    },
    "localizations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 35
      }
    },
    "mcp": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "mcp-endpoint.schema.json"
      }
    },
    "keywords": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
      }
    },
    "branding": {
      "$ref": "service-branding.schema.json"
    },
    "operations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 7,
      "allOf": [
        {
          "contains": {
            "properties": {
              "name": {
                "const": "list-offerings"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "get-offering"
              }
            },
            "required": [
              "name"
            ]
          }
        }
      ],
      "items": {
        "$ref": "operation-descriptor.schema.json"
      }
    },
    "http": {
      "type": "object",
      "required": [
        "endpoint_base"
      ],
      "properties": {
        "endpoint_base": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^/(?!/)[A-Za-z0-9._~!$&'()*+,;=:@%/-]*$"
        },
        "openapi": {
          "$ref": "service-openapi.schema.json"
        }
      }
    },
    "protocols": {
      "$ref": "service-protocols.schema.json"
    },
    "payment_origins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "service-origin.schema.json"
      }
    },
    "search_capabilities": {
      "$ref": "search-capabilities.schema.json"
    },
    "status_url": {
      "$ref": "resource-reference.schema.json"
    },
    "support_url": {
      "$ref": "resource-reference.schema.json"
    },
    "website_url": {
      "$ref": "resource-reference.schema.json"
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/unique-operation-names"
    },
    {
      "if": {
        "properties": {
          "operations": {
            "contains": {
              "properties": {
                "authentication": {
                  "enum": [
                    "optional",
                    "required"
                  ]
                }
              },
              "required": [
                "authentication"
              ]
            }
          }
        },
        "required": [
          "operations"
        ]
      },
      "then": {
        "properties": {
          "protocols": {
            "required": [
              "enrollment"
            ]
          }
        },
        "required": [
          "protocols"
        ]
      }
    }
  ],
  "$defs": {
    "unique-operation-names": {
      "allOf": [
        {
          "$ref": "#/$defs/at-most-one-get-collection"
        },
        {
          "$ref": "#/$defs/at-most-one-get-offering"
        },
        {
          "$ref": "#/$defs/at-most-one-list-collection-offerings"
        },
        {
          "$ref": "#/$defs/at-most-one-list-collections"
        },
        {
          "$ref": "#/$defs/at-most-one-list-offerings"
        },
        {
          "$ref": "#/$defs/at-most-one-search-collections"
        },
        {
          "$ref": "#/$defs/at-most-one-search-offerings"
        }
      ]
    },
    "at-most-one-get-collection": {
      "properties": {
        "operations": {
          "contains": {
            "properties": {
              "name": {
                "const": "get-collection"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        }
      }
    },
    "at-most-one-get-offering": {
      "properties": {
        "operations": {
          "contains": {
            "properties": {
              "name": {
                "const": "get-offering"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        }
      }
    },
    "at-most-one-list-collection-offerings": {
      "properties": {
        "operations": {
          "contains": {
            "properties": {
              "name": {
                "const": "list-collection-offerings"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        }
      }
    },
    "at-most-one-list-collections": {
      "properties": {
        "operations": {
          "contains": {
            "properties": {
              "name": {
                "const": "list-collections"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        }
      }
    },
    "at-most-one-list-offerings": {
      "properties": {
        "operations": {
          "contains": {
            "properties": {
              "name": {
                "const": "list-offerings"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        }
      }
    },
    "at-most-one-search-collections": {
      "properties": {
        "operations": {
          "contains": {
            "properties": {
              "name": {
                "const": "search-collections"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        }
      }
    },
    "at-most-one-search-offerings": {
      "properties": {
        "operations": {
          "contains": {
            "properties": {
              "name": {
                "const": "search-offerings"
              }
            },
            "required": [
              "name"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        }
      }
    }
  }
}
