{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offeringprotocol.org/schemas/page-envelope.schema.json",
  "title": "ODP page envelope",
  "type": "object",
  "required": [
    "odp_version",
    "items"
  ],
  "properties": {
    "auth_expands": {
      "const": true
    },
    "odp_version": {
      "const": "1.0"
    },
    "items": {
      "type": "array",
      "maxItems": 100
    },
    "next": {
      "$ref": "resource-reference.schema.json"
    }
  }
}
